# Copy the DIRECT connection string from the Neon console (host without "-pooler"),
# then change its scheme to postgresql+asyncpg:// and its query to ?ssl=require
# (asyncpg does not accept Neon's sslmode / channel_binding parameters).
# Format is documented in README.md under "Environment Configuration".
DATABASE_URL=

# Optional GDPR search (needs `pip install -r requirements-search.txt`; see README "GDPR search")
# SEARCH_ENABLED=true
# SEARCH_MAX_QUEUE=8
# SEARCH_TIMEOUT_SECONDS=60
